# Copy this file to .env and fill in the passwords.

# PostgreSQL superuser, used only by scripts/setup.js to create the two roles
# and the database. This is the password chosen when PostgreSQL was installed.
PG_SUPERUSER=postgres
PG_SUPERPASS=your_postgres_password

# connection settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=pharmacy

# the role the API connects as (SELECT, INSERT, limited UPDATE)
PGUSER=pharmacy_app
PGPASSWORD=choose_a_password

# the role that owns every table (setup creates both roles with these passwords)
PGOWNER_USER=pharmacy_owner
PGOWNER_PASSWORD=choose_another_password

# MongoDB, default local install
MONGO_URL=mongodb://localhost:27017
MONGO_DB=pharmacy

# port the app runs on
PORT=4000
